{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "setup": "cp -n .env.example .env && node ace generate:key",
    "dev": "node ace serve --watch",
    "generate": "node ace codegen && node ace openapi:generate",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#types/*": "./app/types/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/lucid": "^22.4.2",
    "@outloud/adonis-openapi": "workspace:*",
    "@outloud/adonis-openapi-generator": "workspace:*",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.3.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.11.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "youch": "^4.1.0"
  }
}
